# Next.js frontend
# Leave empty to use the built-in Next.js demo API routes.
# Set this to your external backend URL when deploying the standalone API.
NEXT_PUBLIC_API_BASE_URL=

# CMS storage for the Next.js admin/public content layer.
# auto = use MySQL only when MYSQL_* values are configured, otherwise use bundled fallback content.
# mysql = require MySQL and fail loudly if the database is unavailable.
# fallback = always use bundled/in-memory fallback content.
CMS_STORAGE=auto

# Optional MySQL CMS/admin storage. Configure these only when you have a real database host.
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_DATABASE=
# MYSQL_USER=
# MYSQL_PASSWORD=
